          "fontSize": "$size-display",
          "fontWeight": "$weight-display"
        },
        {
          "type": "text",
          "id": "E8HHj",
          "name": "构图原则",
          "fill": "$secondary",
          "textGrowth": "fixed-width",
          "width": 1200,
          "content": "清楚的任务与设备归属、可感知连续折射的玻璃操作层、系统偏好适配；黑白主调与明亮点缀色共同建立身份。",
          "lineHeight": "$line-body",
          "fontFamily": "$font-body",
          "fontSize": "$size-body",
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "u8HjQ7",
          "name": "核心材料与颜色",
          "context": "瓷白／炭黑建立安静内容层；连接蓝、画面紫、活动绿、提醒琥珀、风险红各有用途。\n17点正文、15点动作与辅助、13点元数据；玻璃采用均匀低强度折射，系统外观及辅助偏好可加厚至实体。\n静态稿表达目标；动态材料、读屏、手势与200%文字仍需运行验证。",
          "width": "fill_container",
          "gap": 24,
          "children": [
            {
              "type": "frame",
              "id": "MShkf",
              "name": "内容画布",
              "width": 260,
              "layout": "vertical",
              "gap": 12,
