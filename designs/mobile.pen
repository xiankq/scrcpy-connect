                  "fontWeight": "$weight-caption"
                },
                {
                  "type": "frame",
                  "id": "Ffm0s",
                  "name": "组件 / 悬浮导航",
                  "context": "稳定选中态亦保留清楚的透镜轮廓、浅色散射和离面阴影；按压/拖动增强但不是唯一可辨状态。设计目标待生产公共接口与GPU验证，不假定库已有常驻镜片",
                  "reusable": true,
                  "width": 354,
                  "height": 64,
                  "fill": {
                    "type": "shader",
                    "enabled": true,
                    "url": "assets/liquid-glass.glsl",
                    "uniforms": {
                      "u_ior": "$glass-refractionIndex",
                      "u_refractionWidth": "$glass-refractionWidth",
                      "u_blur": "$glass-blur",
                      "u_tint": "$glass",
                      "u_edgeLight": "$glass-edge",
                      "u_specularThickness": "$glass-specularThickness",
                      "u_specularSharpness": "$glass-specularSharpness",
                      "u_specularAngle": "$glass-angle",
                      "u_specularSpread": "$glass-specularSpread",
                      "u_specularIntensity": "$glass-specularIntensity",
                      "u_specularOppositeIntensity": "$glass-specularOppositeIntensity",
                      "u_glowThickness": "$glass-glowThickness",
                      "u_glowAngle": "$glass-glowAngle",
                      "u_glowSpread": "$glass-glowSpread",
                      "u_glowIntensity": "$glass-glowIntensity",
                      "u_glowOppositeIntensity": "$glass-glowOppositeIntensity",
                      "u_opticalDepth": "$glass-opticalDepth"
                    }
                  },
                  "cornerRadius": "$radius-full",
                  "stroke": "$transparent",
                  "strokeAlignment": "inner",
                  "effect": {
                    "type": "shadow",
                    "shadowType": "outer",
                    "color": "$shadow",
                    "offset": {
                      "x": 0,
                      "y": "$glass-shadowOffset"
                    },
                    "blur": "$glass-shadowBlur"
                  },
                  "gap": "$space-xxs",
                  "padding": "$space-xs",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "fQuah",
                      "name": "设备",
                      "context": "稳定选中玻璃，浅色模式静止仍清楚可辨，不额外叠加固定描边",
                      "width": "fill_container",
                      "height": "fill_container",
                      "fill": {
                        "type": "shader",
                        "enabled": true,
                        "url": "assets/liquid-glass.glsl",
                        "uniforms": {
                          "u_ior": "$navigation-lens-refractionIndex",
                          "u_refractionWidth": "$glass-refractionWidth",
                          "u_blur": 0,
                          "u_tint": "$glass-selected",
                          "u_edgeLight": "$glass-edge",
                          "u_specularThickness": "$glass-specularThickness",
                          "u_specularSharpness": "$glass-specularSharpness",
                          "u_specularAngle": "$glass-angle",
                          "u_specularSpread": "$glass-specularSpread",
                          "u_specularIntensity": "$navigation-lens-specularIntensity",
                          "u_specularOppositeIntensity": "$glass-specularOppositeIntensity",
                          "u_glowThickness": "$glass-glowThickness",
                          "u_glowAngle": "$glass-glowAngle",
                          "u_glowSpread": "$glass-glowSpread",
                          "u_glowIntensity": "$glass-glowIntensity",
                          "u_glowOppositeIntensity": "$glass-glowOppositeIntensity",
                          "u_opticalDepth": "$navigation-lens-opticalDepth"
                        }
                      },
                      "cornerRadius": "$radius-full",
                      "stroke": "$transparent",
                      "effect": {
