                  "u_specularOppositeIntensity": "$glass-specularOppositeIntensity",
                  "u_glowThickness": "$glass-glowThickness",
                  "u_glowAngle": "$glass-glowAngle",
                  "u_glowSpread": "$glass-glowSpread",
                  "u_glowIntensity": "$glass-glowIntensity",
                  "u_glowOppositeIntensity": "$glass-glowOppositeIntensity",
                  "u_opticalDepth": "$glass-opticalDepth"
                }
              },
              "stroke": "$transparent",
              "strokeWidth": 0,
              "strokeAlignment": "inner",
              "effect": {
                "type": "shadow",
                "shadowType": "outer",
                "color": "$shadow",
                "offset": {
