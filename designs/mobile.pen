                  "width": "fill_container",
                  "content": "按同一产品分组排列。只画变化部位，说明标明来源；设计状态不等于新路由或已交付功能。",
                  "lineHeight": "$line-body",
                  "fontFamily": "$font-body",
                  "fontSize": "$size-body",
                  "fontWeight": "normal"
                }
              ]
