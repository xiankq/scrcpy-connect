{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "DYMK6",
      "x": 0,
      "y": 0,
      "name": "入口 / 设计导览",
      "width": 3200,
      "fill": "$canvas",
      "cornerRadius": "$radius-xl",
      "layout": "vertical",
      "gap": 24,
      "padding": 80,
      "children": [
        {
          "type": "text",
          "id": "F3BdbH",
          "name": "产品名称",
          "fill": "$text",
          "content": "邻接",
          "fontFamily": "$font-display",
          "fontSize": 48,
          "fontWeight": "$weight-display",
