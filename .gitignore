# Design preview exports belong in the system temporary directory.
/designs/previews/

# Workspace outputs and machine-local configuration.
/target/
**/target/
/.dart_tool/
/build/
**/.dart_tool/
**/build/
**/android/local.properties
**/android/.gradle/
**/android/.kotlin/
**/android/app/src/main/jniLibs/
**/.flutter-plugins-dependencies
**/__pycache__/
*.py[cod]
**/.DS_Store
.env
*.keystore
*.jks

# Flutter application and editor outputs (the application lives at the root).
*.iml
*.ipr
*.iws
.idea/
/coverage/
/.pub/
/.pub-cache/
/.widget_preview/
/android/app/debug/
/android/app/profile/
/android/app/release/

# Pinned build-time design tooling.
**/node_modules/

# Vendored plugin source is tracked; downloaded SDKs and native outputs are not.
/third_party/fvp/**/.cxx/
/third_party/fvp/**/mdk-sdk/
/third_party/fvp/**/mdk-sdk-*
/third_party/fvp/**/fvp-deps.lock
/third_party/fvp/**/.fvp-mdk-backup/
/third_party/fvp/**/.fvp-mdk-extract/
/third_party/fvp/lib/src/version.h
