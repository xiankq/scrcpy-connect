+package com.genymobile.scrcpy.video;
+
+import java.io.IOException;
+
+/** Per-codec input lifetime. Adapters which do not opt in retain a no-op flow. */
+public interface EncoderInputFlow {
+    EncoderInputFlow NONE = new EncoderInputFlow() { };
+
+    default void activate() { }
+    default void validateOutput(int flags, int size) throws IOException { }
+    default void onOutputReleased(long ptsUs, int flags, int size) { }
+    default void checkFailure() throws IOException { }
+    default void close() { }
+}
