+package com.genymobile.scrcpy.video;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.function.LongSupplier;
+
+/** One GL-thread-confined generation. No Android dependency and no credit waits. */
+public final class LatestInputWindow {
+    public static final int CONFIG = 2;
+    public static final int EOS = 4;
+    public static final int PARTIAL = 8;
+    public static final long STALL_NS = 3_000_000_000L;
+
+    public interface Scheduler {
+        void post(Runnable task, long delayNs);
+        void cancel(Runnable task);
+    }
+
+    public interface Submitter {
+        void submit(Frame frame) throws Exception;
+    }
+
+    public static final class Frame {
+        public final long sourceTimestampNs;
+        public final long presentationTimeUs;
+        public final boolean repeat;
+        public final long reservedAtNs;
+
+        private Frame(long sourceTimestampNs, long presentationTimeUs, boolean repeat, long now) {
+            this.sourceTimestampNs = sourceTimestampNs;
+            this.presentationTimeUs = presentationTimeUs;
+            this.repeat = repeat;
+            this.reservedAtNs = now;
+        }
+    }
+
+    private final LongSupplier clock;
+    private final Scheduler scheduler;
+    private final Submitter submitter;
+    private final long repeatNs;
+    private final long minIntervalNs;
+    private final Map<Long, Frame> ledger = new LinkedHashMap<>();
+    private final Runnable drain = this::drain;
+    private boolean active;
+    private boolean closed;
+    private boolean hasSource;
+    private boolean pending;
+    private boolean scheduled;
+    private long scheduledAtNs;
+    private long sourceTimestampNs;
+    private long lastPtsUs = -1;
+    private long lastSubmitNs;
+    private long nextInputNs;
+    // Read-only snapshots for the encoder's 100 ms failure poll; ledger stays on GL.
+    private volatile long stallDeadlineNs;
+    private volatile Throwable failure;
+
+    public LatestInputWindow(LongSupplier clock, Scheduler scheduler, Submitter submitter, long repeatUs, float maxFps) {
+        if (repeatUs < 0 || repeatUs > Long.MAX_VALUE / 1000 || !Float.isFinite(maxFps) || maxFps < 0) {
+            throw new IllegalArgumentException("Invalid bounded input cadence");
+        }
+        this.clock = clock;
+        this.scheduler = scheduler;
+        this.submitter = submitter;
+        this.repeatNs = repeatUs * 1000;
+        this.minIntervalNs = maxFps > 0 ? Math.max(1, (long) Math.ceil(1_000_000_000d / maxFps)) : 0;
+    }
+
+    public void activate() {
+        if (closed) {
+            return;
+        }
+        active = true;
+        request(clock.getAsLong());
+    }
+
+    public void onSource(long timestampNs) {
+        if (closed) {
+            return;
+        }
+        sourceTimestampNs = timestampNs;
+        hasSource = true;
+        pending = true;
+        if (active) {
+            request(clock.getAsLong());
+        }
+    }
+
+    /** Called only after a complete packet was delivered and its output buffer released. */
+    public void complete(long ptsUs, int flags, int size) {
+        if (closed) {
+            return;
+        }
+        if ((flags & PARTIAL) != 0) {
+            fail(new IllegalStateException("Partial encoder output is unsupported"));
+            return;
+        }
+        if ((flags & CONFIG) != 0 || size == 0) {
+            return; // Config and empty EOS do not consume a media input.
+        }
+        if (ledger.remove(ptsUs) == null) {
+            fail(new IllegalStateException("Unknown or duplicate media output PTS: " + ptsUs));
+            return;
+        }
+        updateDeadline();
+        request(clock.getAsLong()); // Final pending frame needs no new source callback.
+    }
+
+    public void checkStall(long now) {
+        if (!closed && stallDeadlineNs != 0 && now >= stallDeadlineNs) {
+            fail(new IllegalStateException("Bounded encoder input stalled for 3 seconds"));
+        }
+    }
+
+    private void drain() {
+        scheduled = false;
+        if (closed) {
+            return;
+        }
+        long now = clock.getAsLong();
+        checkStall(now);
+        if (closed || !active || !hasSource) {
+            return;
+        }
+        long due = pending ? nextInputNs : (repeatNs == 0 ? Long.MAX_VALUE : Math.max(nextInputNs, lastSubmitNs + repeatNs));
+        if (ledger.size() < 2 && now >= due) {
+            boolean repeat = !pending;
+            long ptsUs = Math.max(lastPtsUs + 1, (repeat ? now : sourceTimestampNs) / 1000);
+            Frame frame = new Frame(sourceTimestampNs, ptsUs, repeat, now);
+            lastPtsUs = ptsUs;
+            pending = false;
+            lastSubmitNs = now;
+            nextInputNs = now + minIntervalNs;
+            // Reserve before swap: a synchronous output can retire this exact input.
+            ledger.put(ptsUs, frame);
+            updateDeadline();
+            try {
+                submitter.submit(frame);
+            } catch (Throwable throwable) {
+                fail(throwable); // Revoke the generation, never fabricate a credit.
+                return;
+            }
+        }
+        scheduleNext();
+    }
+
+    private void scheduleNext() {
+        if (closed) {
+            return;
+        }
+        long next = stallDeadlineNs == 0 ? Long.MAX_VALUE : stallDeadlineNs;
+        if (ledger.size() < 2 && hasSource) {
+            long inputDue = pending ? nextInputNs : (repeatNs == 0 ? Long.MAX_VALUE : Math.max(nextInputNs, lastSubmitNs + repeatNs));
+            next = Math.min(next, inputDue);
+        }
+        if (next != Long.MAX_VALUE) {
+            request(next);
+        }
+    }
+
+    private void updateDeadline() {
+        stallDeadlineNs = ledger.isEmpty() ? 0 : ledger.values().iterator().next().reservedAtNs + STALL_NS;
+    }
+
+    private void request(long atNs) {
+        if (closed || (scheduled && scheduledAtNs <= atNs)) {
+            return;
+        }
+        if (scheduled) {
+            scheduler.cancel(drain);
+        }
+        scheduled = true;
+        scheduledAtNs = atNs;
+        scheduler.post(drain, Math.max(0, atNs - clock.getAsLong()));
+    }
+
+    public void fail(Throwable throwable) {
+        if (!closed) {
+            failure = throwable;
+            close();
+        }
+    }
+
+    public void close() {
+        closed = true;
+        active = false;
+        pending = false;
+        hasSource = false;
+        if (scheduled) {
+            scheduler.cancel(drain);
+            scheduled = false;
+        }
+        ledger.clear();
+        stallDeadlineNs = 0;
+    }
+
+    public Throwable getFailure() {
+        return failure;
+    }
+
+    public long getStallDeadlineNs() {
+        return stallDeadlineNs;
+    }
+
+    public int inFlight() {
+        return ledger.size();
+    }
+
+    public boolean isClosed() {
+        return closed;
+    }
+}
