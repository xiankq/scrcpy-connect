+package com.genymobile.scrcpy.video;
+
+import android.os.Handler;
+
+import java.io.IOException;
+
+/** Android bridge: every ledger, source, timer and credit operation runs on the GL handler. */
+public final class BoundedInputFlow implements EncoderInputFlow {
+    private final long repeatUs;
+    private final float maxFps;
+    private Handler handler;
+    private volatile LatestInputWindow window;
+    private volatile boolean closed;
+    private volatile Throwable failure;
+
+    public BoundedInputFlow(long repeatUs, float maxFps) {
+        this.repeatUs = repeatUs;
+        this.maxFps = maxFps;
+    }
+
+    public void attach(Handler glHandler, LatestInputWindow.Submitter submitter) {
+        handler = glHandler;
+        window = new LatestInputWindow(System::nanoTime, new LatestInputWindow.Scheduler() {
+            @Override
+            public void post(Runnable task, long delayNs) {
+                if (!handler.postDelayed(task, (delayNs + 999_999) / 1_000_000)) {
+                    fail(new IllegalStateException("GL handler rejected input drain"));
+                }
+            }
+
+            @Override
+            public void cancel(Runnable task) {
+                handler.removeCallbacks(task);
+            }
+        }, frame -> {
+            if (closed) {
+                throw new IllegalStateException("Input generation closed before swap");
+            }
+            submitter.submit(frame);
+        }, repeatUs, maxFps);
+        if (closed) {
+            window.close();
+        }
+    }
+
+    public void onSource(long sourceTimestampNs) {
+        if (!closed) {
+            window.onSource(sourceTimestampNs);
+        }
+    }
+
+    @Override
+    public void activate() {
+        post(() -> window.activate());
+    }
+
+    @Override
+    public void validateOutput(int flags, int size) throws IOException {
+        if ((flags & LatestInputWindow.PARTIAL) != 0) {
+            throw new IOException("bounded-input rejects partial encoder output");
+        }
+        checkFailure();
+    }
+
+    @Override
+    public void onOutputReleased(long ptsUs, int flags, int size) {
+        post(() -> window.complete(ptsUs, flags, size));
+    }
+
+    private void post(Runnable action) {
+        if (!closed && !handler.post(() -> {
+            if (!closed) {
+                try {
+                    action.run();
+                } catch (Throwable throwable) {
+                    fail(throwable);
+                }
+            }
+        })) {
+            fail(new IllegalStateException("GL handler rejected input operation"));
+        }
+    }
+
+    public void fail(Throwable throwable) {
+        failure = throwable;
+        close();
+    }
+
+    @Override
+    public void checkFailure() throws IOException {
+        LatestInputWindow state = window;
+        Throwable error = failure != null ? failure : (state == null ? null : state.getFailure());
+        if (error != null) {
+            throw new IOException("bounded-input GL/input failure", error);
+        }
+        // This snapshot also bounds a swap which stopped servicing the GL timer.
+        long deadline = state == null ? 0 : state.getStallDeadlineNs();
+        if (!closed && deadline != 0 && System.nanoTime() >= deadline) {
+            throw new IOException("bounded-input encoder input stalled for 3 seconds");
+        }
+    }
+
+    @Override
+    public void close() {
+        closed = true; // Revoke output callbacks and pre-swap guards immediately.
+        Handler glHandler = handler;
+        if (glHandler != null) {
+            glHandler.post(() -> window.close());
+        }
+    }
+}
