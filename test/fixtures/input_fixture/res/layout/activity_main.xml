<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#FFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Input test receiver" android:textSize="28sp" android:textColor="#111111" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:textSize="16sp" android:textColor="#333333"
        android:text="Test fixture only. Records real Android dispatchKeyEvent callbacks for DPAD DOWN. The product does not require this APK." />
    <TextView android:id="@+id/state" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="32dp"
        android:textSize="18sp" android:textColor="#111111" android:fontFamily="monospace"
        android:importantForAccessibility="yes" />
</LinearLayout>
