# 只支持固定的纯解码构建，不回退到系统或完整播放器 FFmpeg，避免静默改变交付能力。
find_package(Python3 COMPONENTS Interpreter REQUIRED)
# CMake REALPATH 不能稳定解析 Flutter 的 Windows 目录链接。
# 派生 workspace 前，使用与依赖构建器一致的 Python 实现解析，使各宿主复用实际包缓存。
execute_process(COMMAND "${Python3_EXECUTABLE}" -c
  "from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().as_posix())"
  "${CMAKE_CURRENT_LIST_DIR}/.."
  OUTPUT_VARIABLE MEDIA_CODEC_PACKAGE_ROOT OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE MEDIA_CODEC_RESOLVE_RESULT)
if(NOT MEDIA_CODEC_RESOLVE_RESULT EQUAL 0)
  message(FATAL_ERROR "Cannot resolve the media_codec package directory")
endif()
get_filename_component(MEDIA_CODEC_WORKSPACE_ROOT "${MEDIA_CODEC_PACKAGE_ROOT}/../.." ABSOLUTE)
if(ANDROID)
  set(MEDIA_CODEC_PLATFORM android)
  if(ANDROID_ABI STREQUAL "arm64-v8a")
    set(MEDIA_CODEC_ARCH arm64)
  elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
    set(MEDIA_CODEC_ARCH arm)
  else()
    set(MEDIA_CODEC_ARCH x64)
  endif()
elseif(WIN32)
  set(MEDIA_CODEC_PLATFORM windows)
  if(CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64")
    set(MEDIA_CODEC_ARCH arm64)
  else()
    set(MEDIA_CODEC_ARCH x64)
  endif()
elseif(APPLE)
  set(MEDIA_CODEC_PLATFORM macos)
  if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set(MEDIA_CODEC_PLATFORM ios)
  endif()
  if(CMAKE_OSX_ARCHITECTURES)
    set(MEDIA_CODEC_APPLE_ARCH "${CMAKE_OSX_ARCHITECTURES}")
  else()
    set(MEDIA_CODEC_APPLE_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  if(MEDIA_CODEC_APPLE_ARCH MATCHES "aarch64|arm64")
    set(MEDIA_CODEC_ARCH arm64)
  else()
    set(MEDIA_CODEC_ARCH x64)
  endif()
else()
  set(MEDIA_CODEC_PLATFORM linux)
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    set(MEDIA_CODEC_ARCH arm64)
  else()
    set(MEDIA_CODEC_ARCH x64)
  endif()
endif()
if(NOT MEDIA_CODEC_FFMPEG_ROOT)
  set(MEDIA_CODEC_FFMPEG_ROOT "$ENV{MEDIA_CODEC_FFMPEG_ROOT}")
endif()
if(NOT MEDIA_CODEC_FFMPEG_ROOT)
  set(MEDIA_CODEC_FFMPEG_ROOT "${MEDIA_CODEC_WORKSPACE_ROOT}/.dart_tool/media_codec/ffmpeg/${MEDIA_CODEC_PLATFORM}-${MEDIA_CODEC_ARCH}")
  set(MEDIA_CODEC_FFMPEG_ARGUMENTS --platform "${MEDIA_CODEC_PLATFORM}" --arch "${MEDIA_CODEC_ARCH}" --prefix "${MEDIA_CODEC_FFMPEG_ROOT}")
  if(ANDROID)
    list(APPEND MEDIA_CODEC_FFMPEG_ARGUMENTS --ndk "${ANDROID_NDK}" --api "${ANDROID_PLATFORM_LEVEL}")
  elseif(APPLE AND MEDIA_CODEC_PLATFORM STREQUAL "ios")
    if(CMAKE_OSX_SYSROOT MATCHES "simulator")
      list(APPEND MEDIA_CODEC_FFMPEG_ARGUMENTS --sdk iphonesimulator)
    else()
      list(APPEND MEDIA_CODEC_FFMPEG_ARGUMENTS --sdk iphoneos)
    endif()
  endif()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${MEDIA_CODEC_PACKAGE_ROOT}/tool/build_ffmpeg.py" ${MEDIA_CODEC_FFMPEG_ARGUMENTS}
    RESULT_VARIABLE MEDIA_CODEC_PREPARE_RESULT COMMAND_ECHO STDOUT)
  if(NOT MEDIA_CODEC_PREPARE_RESULT EQUAL 0)
    message(FATAL_ERROR "Trimmed FFmpeg preparation failed")
  endif()
endif()
if(NOT EXISTS "${MEDIA_CODEC_FFMPEG_ROOT}/media-codec-build.json")
  message(FATAL_ERROR "FFmpeg prefix lacks the decode-only build receipt: ${MEDIA_CODEC_FFMPEG_ROOT}")
endif()
add_library(mc_ffmpeg INTERFACE)
target_include_directories(mc_ffmpeg SYSTEM INTERFACE "${MEDIA_CODEC_FFMPEG_ROOT}/include")
foreach(component swscale avcodec dav1d avutil)
  # 重新配置可能替换此前选择的 SDK、架构或前缀。
  unset(MEDIA_CODEC_${component}_LIBRARY CACHE)
  find_library(MEDIA_CODEC_${component}_LIBRARY NAMES ${component} lib${component}
    PATHS "${MEDIA_CODEC_FFMPEG_ROOT}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
  target_link_libraries(mc_ffmpeg INTERFACE "${MEDIA_CODEC_${component}_LIBRARY}")
endforeach()

if(MEDIA_CODEC_PLATFORM STREQUAL "linux")
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(MC_VA REQUIRED IMPORTED_TARGET libva libva-drm libdrm)
  target_link_libraries(mc_ffmpeg INTERFACE PkgConfig::MC_VA m ${CMAKE_DL_LIBS})
elseif(WIN32)
  target_link_libraries(mc_ffmpeg INTERFACE bcrypt ole32 uuid dxva2 d3d11)
elseif(ANDROID)
  target_link_libraries(mc_ffmpeg INTERFACE android log mediandk z m atomic)
elseif(APPLE)
  target_link_libraries(mc_ffmpeg INTERFACE "-framework VideoToolbox" "-framework CoreMedia" "-framework CoreVideo" "-framework CoreFoundation" "-framework Security")
endif()
