+int ff_AMediaCodec_setOutputSurface(FFAMediaCodec *ctx, void *native_window)
+{
+    FFAMediaCodecNdk *codec;
+    media_status_t status;
+    if (!ctx || ctx->class != &amediacodec_ndk_class || !native_window)
+        return AVERROR(ENOSYS);
+    codec = (FFAMediaCodecNdk *)ctx;
+    if (!codec->setOutputSurface)
+        return AVERROR(ENOSYS);
+    status = codec->setOutputSurface(codec->impl, native_window);
+    if (status != AMEDIA_OK) {
+        av_log(codec, AV_LOG_WARNING, "setOutputSurface failed: %d\n", status);
+        return AVERROR_EXTERNAL;
+    }
+    ANativeWindow_acquire(native_window);
+    if (codec->window)
+        ANativeWindow_release(codec->window);
+    codec->window = native_window;
+    return 0;
