+{
+    MediaCodecContext *s;
+    if (!avctx || !avctx->codec || !strstr(avctx->codec->name, "_mediacodec") || !avctx->priv_data)
+        return NULL;
+    s = avctx->priv_data;
+    return s->ctx ? s->ctx->codec_name : NULL;
