+int av_mediacodec_set_output_window(AVCodecContext *avctx, void *native_window)
+{
+    MediaCodecContext *s;
+    FFANativeWindow *next;
+    int result;
+    if (!avctx || !native_window || !avctx->codec || !avctx->priv_data ||
+        !strstr(avctx->codec->name, "_mediacodec"))
+        return AVERROR(EINVAL);
+    s = avctx->priv_data;
+    if (!s->ctx || !s->ctx->codec || !s->ctx->surface || !s->ctx->started)
+        return AVERROR(ENOSYS);
+    next = ff_mediacodec_surface_ref(NULL, native_window, avctx);
+    if (!next)
+        return AVERROR(ENOMEM);
+    result = ff_AMediaCodec_setOutputSurface(s->ctx->codec, native_window);
+    if (result < 0) {
+        ff_mediacodec_surface_unref(next, avctx);
+        return result;
+    }
+    ff_mediacodec_surface_unref(s->ctx->surface, avctx);
+    s->ctx->surface = next;
+    return 0;
+}
 
